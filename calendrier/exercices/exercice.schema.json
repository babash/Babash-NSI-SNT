{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://babash.github.io/Babash-NSI-SNT/calendrier/exercices/exercice.schema.json",
  "title": "Calendrier des vacances : la banque d'exercices d'un thème",
  "description": "Un fichier par thème (calendrier/exercices/<thème>.json). Un thème est un chapitre (« Listes et dictionnaires ») ou une notion plus fine (« Les boucles », « Le binaire ») ; ses niveaux sont indicatifs : l'enseignant·e coche librement les thèmes d'un calendrier, quel que soit le niveau de la classe, et les cases alternent entre eux. L'exercice de rang r (1, 2, 3…) est le r-ième de la liste : on ajoute toujours à la fin, on ne réordonne jamais un exercice publié, et son id ne change jamais. Chaque exercice a 3 niveaux (Facile, Moyen, Costaud). Le contrôle (scripts/calendrier_exercices.py) vérifie ce schéma, puis exécute chaque programme et compare ce qu'il affiche à ce que l'exercice annonce. Jamais de nom d'élève ; des prénoms variés et épicènes dans les énoncés.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exercices"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "theme": {
      "$ref": "#/$defs/theme"
    },
    "chapitre": {
      "$ref": "#/$defs/theme",
      "description": "Ancien nom de « theme » : accepté (avertissement du contrôle), à renommer."
    },
    "base_sql": {
      "type": "string",
      "maxLength": 20000,
      "description": "Obligatoire si langage = sql : le script CREATE TABLE et INSERT de la base d'exemple, commun à tous les exercices du thème. Les requêtes s'exécutent dessus (SQLite)."
    },
    "exercices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 99,
      "items": {
        "$ref": "#/$defs/exercice"
      }
    }
  },
  "$defs": {
    "identifiant": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 60
    },
    "texte": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200,
      "description": "Un programme : lignes séparées par \\n, indentation de 4 espaces, jamais de tabulation."
    },
    "aides": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 200
      },
      "description": "Les coups de pouce, du plus léger au plus fort ; jamais la réponse."
    },
    "exercice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "titre",
        "objectif",
        "niveaux",
        "relu"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-[0-9]{3}$",
          "description": "<id du thème>-<rang sur 3 chiffres>, par exemple py-boucles-007."
        },
        "type": {
          "enum": [
            "associer",
            "erreur",
            "vraifaux",
            "sortie",
            "ordre",
            "completer",
            "trace",
            "combien",
            "paniers",
            "intrus",
            "memo",
            "bits"
          ],
          "description": "Le mini-jeu (spécification, § 5.2). Les six premiers depuis le 20/11 ; trace, combien, paniers, intrus, memo et bits depuis T135 (24/11). Un exemple complet de chacun : calendrier/exercices/LISEZMOI.md."
        },
        "titre": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "description": "Un titre qui donne envie (« Chasse au bug »)."
        },
        "objectif": {
          "type": "string",
          "minLength": 10,
          "maxLength": 140,
          "description": "Affiché au début du jeu : ce que l'on entraîne."
        },
        "notions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 60
          }
        },
        "auteur": {
          "type": "string",
          "maxLength": 120
        },
        "relu": {
          "type": "boolean",
          "description": "Vrai quand l'enseignant·e (ou un·e relecteur·rice) a relu l'exercice. Un calendrier réel ne prend que des exercices relus (avertissement sinon)."
        },
        "niveaux": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "duree",
              "items"
            ],
            "properties": {
              "duree": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8,
                "description": "Minutes, environ : Facile 2-3, Moyen 3-5, Costaud 4-8."
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "associer"
              }
            }
          },
          "then": {
            "properties": {
              "niveaux": {
                "items": {
                  "properties": {
                    "items": {
                      "items": {
                        "$ref": "#/$defs/associer"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "erreur"
              }
            }
          },
          "then": {
            "properties": {
              "niveaux": {
                "items": {
                  "properties": {
                    "items": {
                      "items": {
                        "$ref": "#/$defs/erreur"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "vraifaux"
              }
            }
          },
          "then": {
            "properties": {
              "niveaux": {
                "items": {
                  "properties": {
                    "items": {
                      "items": {
                        "$ref": "#/$defs/vraifaux"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "sortie"
              }
            }
          },
          "then": {
            "properties": {
              "niveaux": {
                "items": {
                  "properties": {
                    "items": {
                      "items": {
                        "$ref": "#/$defs/sortie"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ordre"
              }
            }
          },
          "then": {
            "properties": {
              "niveaux": {
                "items": {
                  "properties": {
                    "items": {
                      "items": {
                        "$ref": "#/$defs/ordre"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "completer"
              }
            }
          },
          "then": {
            "properties": {
              "niveaux": {
                "items": {
                  "properties": {
                    "items": {
                      "items": {
                        "$ref": "#/$defs/completer"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "trace"
              }
            }
          },
          "then": {
            "properties": {
              "niveaux": {
                "items": {
                  "properties": {
                    "items": {
                      "items": {
                        "$ref": "#/$defs/trace"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "combien"
              }
            }
          },
          "then": {
            "properties": {
              "niveaux": {
                "items": {
                  "properties": {
                    "items": {
                      "items": {
                        "$ref": "#/$defs/combien"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "paniers"
              }
            }
          },
          "then": {
            "properties": {
              "niveaux": {
                "items": {
                  "properties": {
                    "items": {
                      "items": {
                        "$ref": "#/$defs/paniers"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "intrus"
              }
            }
          },
          "then": {
            "properties": {
              "niveaux": {
                "items": {
                  "properties": {
                    "items": {
                      "items": {
                        "$ref": "#/$defs/intrus"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "memo"
              }
            }
          },
          "then": {
            "properties": {
              "niveaux": {
                "items": {
                  "properties": {
                    "items": {
                      "items": {
                        "$ref": "#/$defs/memo"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "bits"
              }
            }
          },
          "then": {
            "properties": {
              "niveaux": {
                "items": {
                  "properties": {
                    "items": {
                      "items": {
                        "$ref": "#/$defs/bits"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "associer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consigne",
        "paires",
        "explication"
      ],
      "properties": {
        "consigne": {
          "$ref": "#/$defs/texte"
        },
        "paires": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "description": "[à gauche, à droite]. Les deux côtés sont tous différents."
        },
        "executer": {
          "type": "boolean",
          "description": "Vrai : chaque élément de gauche est un programme, et ce qu'il affiche (lignes jointes par « , ») doit être l'élément de droite."
        },
        "aides": {
          "$ref": "#/$defs/aides"
        },
        "explication": {
          "$ref": "#/$defs/texte"
        }
      }
    },
    "erreur": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "but",
        "lignes",
        "ligne",
        "corrections",
        "bonne",
        "affiche",
        "explication"
      ],
      "properties": {
        "but": {
          "$ref": "#/$defs/texte",
          "description": "Ce que doit faire le programme, sans le message d'erreur (il va dans « message » ou « affiche_fautif »)."
        },
        "lignes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "ligne": {
          "type": "integer",
          "minimum": 0,
          "description": "Indice (à partir de 0) de la ligne fausse."
        },
        "corrections": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "bonne": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "affiche": {
          "type": "string",
          "maxLength": 1000,
          "description": "Ce qu'affiche le programme corrigé. Le contrôle vérifie aussi que le programme fautif et les deux mauvaises corrections n'affichent pas cela."
        },
        "aides": {
          "$ref": "#/$defs/aides"
        },
        "explication": {
          "$ref": "#/$defs/texte"
        },
        "arbre": {
          "$ref": "#/$defs/arbre"
        },
        "message": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300,
          "description": "Le message réel du programme fautif, tel que Python 3.13 (dernière ligne : « IndexError: list index out of range ») ou SQLite (« Error: near \"plage\": syntax error ») le donne. La page l'affiche sous le code, en console. Un seul champ parmi message, affiche_fautif, boucle_infinie."
        },
        "affiche_fautif": {
          "type": "string",
          "maxLength": 1000,
          "description": "Pour une erreur de logique : ce qu'affiche le programme fautif (vide s'il n'affiche rien). La page l'affiche sous le code."
        },
        "boucle_infinie": {
          "const": true,
          "description": "Le programme fautif ne s'arrête pas : la page le dit sous le code."
        }
      }
    },
    "vraifaux": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "texte",
        "reponse",
        "explication"
      ],
      "properties": {
        "texte": {
          "type": "string",
          "minLength": 5,
          "maxLength": 200
        },
        "reponse": {
          "type": "boolean"
        },
        "code": {
          "$ref": "#/$defs/code"
        },
        "verifier": {
          "type": "string",
          "maxLength": 300,
          "description": "Python : une expression évaluée après le code, qui doit valoir « reponse » (s == 10). SQL : une requête SELECT d'une seule valeur, exécutée après le code ; vraie si elle ne vaut ni 0 ni NULL."
        },
        "explication": {
          "$ref": "#/$defs/texte"
        },
        "arbre": {
          "$ref": "#/$defs/arbre"
        }
      }
    },
    "sortie": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "description": "Quatre sorties possibles ; « / » sépare les lignes affichées (« 0 / 1 / 2 »)."
        },
        "bonne": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "retours": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "description": "Un retour par option : pour une mauvaise, l'erreur de raisonnement qu'elle trahit, sans donner la réponse."
        },
        "reponse": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Réponse à taper (niveau Costaud) : la sortie exacte, sur une ligne."
        },
        "explication": {
          "$ref": "#/$defs/texte"
        },
        "aides": {
          "$ref": "#/$defs/aides"
        },
        "arbre": {
          "$ref": "#/$defs/arbre"
        }
      },
      "oneOf": [
        {
          "required": [
            "options",
            "bonne",
            "retours"
          ],
          "not": {
            "required": [
              "reponse"
            ]
          }
        },
        {
          "required": [
            "reponse",
            "explication"
          ],
          "not": {
            "required": [
              "options"
            ]
          }
        }
      ]
    },
    "ordre": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "but",
        "lignes",
        "affiche"
      ],
      "properties": {
        "but": {
          "$ref": "#/$defs/texte"
        },
        "lignes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 120
          },
          "description": "Les lignes dans le bon ordre (la page les mélange). Une seule disposition doit être juste."
        },
        "affiche": {
          "type": "string",
          "maxLength": 1000
        },
        "aides": {
          "$ref": "#/$defs/aides"
        },
        "arbre": {
          "$ref": "#/$defs/arbre"
        }
      }
    },
    "completer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "but",
        "lignes",
        "trous",
        "affiche",
        "explication"
      ],
      "properties": {
        "but": {
          "$ref": "#/$defs/texte"
        },
        "lignes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string",
            "maxLength": 120
          },
          "description": "Les trous s'écrivent {0}, {1}… dans les lignes."
        },
        "trous": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "options",
              "bonne"
            ],
            "properties": {
              "options": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                }
              },
              "bonne": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              }
            }
          }
        },
        "affiche": {
          "type": "string",
          "maxLength": 1000,
          "description": "Ce qu'affiche le programme complété. Le contrôle vérifie que chaque mauvaise pièce change le résultat."
        },
        "aides": {
          "$ref": "#/$defs/aides"
        },
        "explication": {
          "$ref": "#/$defs/texte"
        },
        "arbre": {
          "$ref": "#/$defs/arbre"
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "titre",
        "langage"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifiant",
          "description": "Par exemple py-boucles, binaire, nsi1-listes-dictionnaires. C'est la valeur gardée dans vacances.cases.theme ; elle ne change jamais."
        },
        "titre": {
          "type": "string",
          "minLength": 3,
          "maxLength": 60
        },
        "nature": {
          "enum": [
            "chapitre",
            "notion"
          ],
          "description": "Un chapitre du programme, ou une notion plus fine qu'on peut cocher seule."
        },
        "niveaux": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "snt",
              "nsi-1re",
              "nsi-tle"
            ]
          },
          "description": "Indicatif : les niveaux pour lesquels le thème est d'abord écrit. Aucune classe n'est imposée."
        },
        "niveau": {
          "enum": [
            "snt",
            "nsi-1re",
            "nsi-tle"
          ],
          "description": "Ancienne forme (un seul niveau) : acceptée, à remplacer par « niveaux »."
        },
        "langage": {
          "enum": [
            "python",
            "sql",
            "aucun"
          ],
          "description": "Le langage des programmes : python (exécuté par python3), sql (exécuté par SQLite sur base_sql), aucun (pas de programme à exécuter)."
        },
        "programme": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 120
          },
          "description": "Nœuds de donnees/referentiels/programmes.json."
        },
        "notions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 60
          },
          "description": "Identifiants de donnees/referentiels/notions.json."
        }
      }
    },
    "arbre": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v"
      ],
      "description": "Un arbre binaire, dessiné par la page sous la question : v est l'étiquette du nœud, g et d ses sous-arbres gauche et droit (absents ou null pour un arbre vide). 31 nœuds au plus, pour rester lisible à 320 px.",
      "properties": {
        "v": {
          "type": [
            "string",
            "number"
          ],
          "maxLength": 6
        },
        "g": {
          "anyOf": [
            {
              "$ref": "#/$defs/arbre"
            },
            {
              "type": "null"
            }
          ]
        },
        "d": {
          "anyOf": [
            {
              "$ref": "#/$defs/arbre"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "colonnes",
        "tours",
        "explication"
      ],
      "description": "Tableau de trace : l'élève écrit la valeur des variables à la fin de chaque tour de la boucle. Le contrôle exécute le code et relève les variables à chaque retour sur la ligne de la boucle.",
      "properties": {
        "consigne": {
          "$ref": "#/$defs/texte",
          "description": "Facultative : par défaut, « Remplis le tableau : la valeur de chaque variable à la fin de chaque tour. »"
        },
        "code": {
          "$ref": "#/$defs/code"
        },
        "boucle": {
          "type": "integer",
          "minimum": 0,
          "description": "Indice (à partir de 0) de la ligne de la boucle suivie. Par défaut : la première ligne qui commence par for ou while."
        },
        "colonnes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "maxLength": 20
          },
          "description": "Les variables suivies (3 au plus, pour tenir à 320 px)."
        },
        "depart": {
          "type": "boolean",
          "description": "Vrai : la première ligne du tableau est « Avant la boucle » (les valeurs au premier passage sur la ligne de la boucle)."
        },
        "tours": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20
            }
          },
