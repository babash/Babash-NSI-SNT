	<question type="multichoice">
		<name>
			<text><![CDATA[[Essai 1] Balises penalty, hidden et generalfeedback]]></text>
		</name>
		<questiontext format="html">
			<text><![CDATA[<p>Cette question contient les balises &lt;penalty&gt;, &lt;hidden&gt; et &lt;generalfeedback&gt;. Si l'import réussit, un texte « À retenir » doit s'afficher après la réponse.</p>]]></text>
		</questiontext>
		<generalfeedback format="html">
			<text><![CDATA[<p>À retenir : ce texte vient de la balise generalfeedback.</p>]]></text>
		</generalfeedback>
		<externallink/>
		<usecase>1</usecase>
		<defaultgrade>1</defaultgrade>
		<penalty>0.3333333</penalty>
		<hidden>0</hidden>
		<single>true</single>
		<shuffleanswers>false</shuffleanswers>
		<answer fraction="100" format="plain_text">
			<text><![CDATA[Réponse A (juste)]]></text>
			<feedback>
				<text><![CDATA[Feedback de la réponse A : il doit s'afficher.]]></text>
			</feedback>
		</answer>
		<answer fraction="0" format="plain_text">
			<text><![CDATA[Réponse B]]></text>
			<feedback>
				<text><![CDATA[Feedback de la réponse B : il doit s'afficher.]]></text>
			</feedback>
		</answer>
		<answer fraction="0" format="plain_text">
			<text><![CDATA[Réponse C]]></text>
			<feedback>
				<text><![CDATA[Feedback de la réponse C : il doit s'afficher.]]></text>
			</feedback>
		</answer>
		<answer fraction="0" format="plain_text">
			<text><![CDATA[Réponse D]]></text>
			<feedback>
				<text><![CDATA[Feedback de la réponse D : il doit s'afficher.]]></text>
			</feedback>
		</answer>
	</question>
	<question type="multichoice">
		<name>
			<text><![CDATA[[Essai 2] Le signe < et les espaces dans les options]]></text>
		</name>
		<questiontext format="html">
			<text><![CDATA[<p>Les options ci-dessous doivent s'afficher exactement comme écrites dans la consigne du LISEZMOI.</p>]]></text>
		</questiontext>
		<externallink/>
		<usecase>1</usecase>
		<defaultgrade>1</defaultgrade>
		<single>true</single>
		<shuffleanswers>false</shuffleanswers>
		<answer fraction="100" format="plain_text">
			<text><![CDATA[<__main__.Segment object at 0x…>]]></text>
			<feedback>
				<text><![CDATA[Option avec < et > : elle doit s'afficher en entier.]]></text>
			</feedback>
		</answer>
		<answer fraction="0" format="plain_text">
			<text><![CDATA[WHERE profondeur < 20 AND a<b]]></text>
			<feedback>
				<text><![CDATA[Option avec « < 20 » et « a<b » : les deux doivent rester visibles.]]></text>
			</feedback>
		</answer>
		<answer fraction="0" format="plain_text">
			<text><![CDATA[x  =  1    (quatre espaces avant la parenthèse)]]></text>
			<feedback>
				<text><![CDATA[Option avec des espaces multiples : regarder s'ils sont gardés ou réduits à un seul.]]></text>
			</feedback>
		</answer>
		<answer fraction="0" format="plain_text">
			<text><![CDATA[Réponse sans caractère spécial]]></text>
			<feedback>
				<text><![CDATA[Option témoin, sans caractère spécial.]]></text>
			</feedback>
		</answer>
	</question>
	<question type="matching">
		<name>
			<text><![CDATA[[Essai 3] Appariement avec explication générale]]></text>
		</name>
		<questiontext format="html">
			<text><![CDATA[<p>Associer chaque droit à sa valeur. Une explication (generalfeedback) doit apparaître après la réponse.</p>]]></text>
		</questiontext>
		<generalfeedback format="html">
			<text><![CDATA[<p>r vaut 4, w vaut 2, x vaut 1.</p>]]></text>
		</generalfeedback>
		<externallink/>
		<usecase>1</usecase>
		<defaultgrade>1</defaultgrade>
		<subquestion>
			<text><![CDATA[Lire (r)]]></text>
			<answer>
				<text><![CDATA[4]]></text>
			</answer>
		</subquestion>
		<subquestion>
			<text><![CDATA[Écrire (w)]]></text>
			<answer>
				<text><![CDATA[2]]></text>
			</answer>
		</subquestion>
		<subquestion>
			<text><![CDATA[Exécuter (x)]]></text>
			<answer>
				<text><![CDATA[1]]></text>
			</answer>
		</subquestion>
		<shuffleanswers>true</shuffleanswers>
	</question>
	<question type="numerical">
		<name>
			<text><![CDATA[[Essai 4] Réponse numérique avec tolérance]]></text>
		</name>
		<questiontext format="html">
			<text><![CDATA[<p>Combien font 2 + 2 ? (La réponse 4 doit être acceptée ; la balise &lt;tolerance&gt; vaut 0.)</p>]]></text>
		</questiontext>
		<externallink/>
		<usecase>0</usecase>
		<defaultgrade>1</defaultgrade>
		<answer fraction="100" format="plain_text">
			<text><![CDATA[4]]></text>
			<tolerance>0</tolerance>
			<feedback>
				<text><![CDATA[Feedback de la bonne réponse numérique : il doit s'afficher.]]></text>
			</feedback>
		</answer>
	</question>
