			<text><![CDATA[9]]></text>
			<feedback>
				<text><![CDATA[9 serait 2 + 3 + 4. Le signe * est une multiplication : 3 * 4 = 12.]]></text>
			</feedback>
		</answer>
		<answer fraction="0" format="plain_text">
			<text><![CDATA[24]]></text>
			<feedback>
				<text><![CDATA[24 serait 2 × 3 × 4. Le premier signe est une addition.]]></text>
			</feedback>
		</answer>
	</question>
