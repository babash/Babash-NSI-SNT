	<question type="multichoice">
		<name>
			<text><![CDATA[[Types] Entier + flottant]]></text>
		</name>
		<questiontext format="html">
			<text><![CDATA[<div style="font-family: Arial, Helvetica, sans-serif; font-size: 14px;"><p style="color: #3b3b3b;"><strong>Objectif :</strong> Prévoir le type du résultat d'une opération entre un entier et un flottant.</p><p>Quel est le type de la valeur de l'expression <code style="font-family: 'Courier New', Courier, monospace; background-color: #f0f0f0; color: #8b0f0f; padding: 1px 4px; border-radius: 3px;">3 + 2.0</code> ?</p></div>]]></text>
		</questiontext>
		<externallink/>
		<usecase>1</usecase>
		<defaultgrade>1</defaultgrade>
		<single>true</single>
		<shuffleanswers>false</shuffleanswers>
		<answer fraction="0" format="plain_text">
			<text><![CDATA[int]]></text>
			<feedback>
				<text><![CDATA[3 est un entier, mais 2.0 est un flottant (il a un point). Dès qu'un flottant est dans le calcul, le résultat est un flottant : 5.0.]]></text>
			</feedback>
		</answer>
		<answer fraction="0" format="plain_text">
			<text><![CDATA[str]]></text>
			<feedback>
				<text><![CDATA[Il n'y a pas de guillemets : ce sont des nombres, pas des textes. Le résultat est le nombre 5.0.]]></text>
			</feedback>
		</answer>
		<answer fraction="0" format="plain_text">
			<text><![CDATA[bool]]></text>
			<feedback>
				<text><![CDATA[Un bool vaut True ou False ; il vient d'une comparaison. Une addition donne un nombre.]]></text>
			</feedback>
		</answer>
		<answer fraction="100" format="plain_text">
			<text><![CDATA[float]]></text>
			<feedback>
				<text><![CDATA[Oui : 3 + 2.0 vaut 5.0. Un calcul entre un int et un float donne un float (un nombre à virgule).]]></text>
			</feedback>
		</answer>
	</question>
	<question type="multichoice">
		<name>
			<text><![CDATA[[Types] Entier × flottant]]></text>
		</name>
		<questiontext format="html">
			<text><![CDATA[<div style="font-family: Arial, Helvetica, sans-serif; font-size: 14px;"><p style="color: #3b3b3b;"><strong>Objectif :</strong> Prévoir le type du résultat d'une multiplication avec un flottant.</p><p>Quel est le type de la valeur de l'expression <code style="font-family: 'Courier New', Courier, monospace; background-color: #f0f0f0; color: #8b0f0f; padding: 1px 4px; border-radius: 3px;">3 * 1.0</code> ?</p></div>]]></text>
		</questiontext>
		<externallink/>
		<usecase>1</usecase>
		<defaultgrade>1</defaultgrade>
		<single>true</single>
		<shuffleanswers>false</shuffleanswers>
		<answer fraction="0" format="plain_text">
			<text><![CDATA[int]]></text>
			<feedback>
				<text><![CDATA[Le résultat a la même valeur que 3, mais il s'écrit 3.0 : c'est un float, car 1.0 est un float.]]></text>
			</feedback>
		</answer>
		<answer fraction="0" format="plain_text">
			<text><![CDATA[str]]></text>
			<feedback>
				<text><![CDATA[Il n'y a pas de guillemets : c'est un calcul sur des nombres.]]></text>
			</feedback>
		</answer>
		<answer fraction="100" format="plain_text">
			<text><![CDATA[float]]></text>
			<feedback>
				<text><![CDATA[Oui : 3 * 1.0 vaut 3.0. Même si le résultat « tombe juste », il reste un float, car 1.0 est un float.]]></text>
			</feedback>
		</answer>
		<answer fraction="0" format="plain_text">
			<text><![CDATA[bool]]></text>
			<feedback>
				<text><![CDATA[Un bool vient d'une comparaison (comme 3 > 1). Une multiplication donne un nombre.]]></text>
			</feedback>
		</answer>
	</question>
	<question type="multichoice">
		<name>
			<text><![CDATA[[Types] Le type de False]]></text>
		</name>
		<questiontext format="html">
			<text><![CDATA[<div style="font-family: Arial, Helvetica, sans-serif; font-size: 14px;"><p style="color: #3b3b3b;"><strong>Objectif :</strong> Reconnaître une valeur booléenne.</p><p>Quel est le type de la valeur <code style="font-family: 'Courier New', Courier, monospace; background-color: #f0f0f0; color: #8b0f0f; padding: 1px 4px; border-radius: 3px;">False</code> ?</p></div>]]></text>
		</questiontext>
		<externallink/>
		<usecase>1</usecase>
		<defaultgrade>1</defaultgrade>
		<single>true</single>
		<shuffleanswers>false</shuffleanswers>
		<answer fraction="0" format="plain_text">
			<text><![CDATA[int]]></text>
			<feedback>
				<text><![CDATA[False s'écrit sans guillemets et avec une majuscule : c'est une valeur de vérité, pas un nombre entier.]]></text>
			</feedback>
		</answer>
		<answer fraction="0" format="plain_text">
			<text><![CDATA[str]]></text>
			<feedback>
				<text><![CDATA[Sans guillemets, False n'est pas un texte. "False", avec des guillemets, serait un str.]]></text>
			</feedback>
		</answer>
		<answer fraction="100" format="plain_text">
			<text><![CDATA[bool]]></text>
			<feedback>
				<text><![CDATA[Oui : True et False sont les deux valeurs du type bool (booléen), le type des conditions.]]></text>
			</feedback>
		</answer>
		<answer fraction="0" format="plain_text">
			<text><![CDATA[NoneType]]></text>
			<feedback>
				<text><![CDATA[NoneType est le type de la seule valeur None, qui veut dire « rien ». False veut dire « faux ».]]></text>
			</feedback>
		</answer>
	</question>
	<question type="multichoice">
		<name>
			<text><![CDATA[[Types] Un nombre entre guillemets]]></text>
		</name>
		<questiontext format="html">
			<text><![CDATA[<div style="font-family: Arial, Helvetica, sans-serif; font-size: 14px;"><p style="color: #3b3b3b;"><strong>Objectif :</strong> Savoir qu'une valeur entre guillemets est une chaîne de caractères.</p><p>Quel est le type de la valeur <code style="font-family: 'Courier New', Courier, monospace; background-color: #f0f0f0; color: #8b0f0f; padding: 1px 4px; border-radius: 3px;">"42"</code> ?</p></div>]]></text>
		</questiontext>
		<externallink/>
		<usecase>1</usecase>
		<defaultgrade>1</defaultgrade>
		<single>true</single>
		<shuffleanswers>false</shuffleanswers>
		<answer fraction="0" format="plain_text">
			<text><![CDATA[int]]></text>
			<feedback>
				<text><![CDATA[Les guillemets changent tout : "42" est un texte de deux caractères, 4 et 2. Sans guillemets, 42 serait un int.]]></text>
			</feedback>
		</answer>
		<answer fraction="100" format="plain_text">
			<text><![CDATA[str]]></text>
			<feedback>
				<text><![CDATA[Oui : tout ce qui est entre guillemets est une chaîne de caractères (str, pour string, « chaîne »).]]></text>
			</feedback>
		</answer>
		<answer fraction="0" format="plain_text">
			<text><![CDATA[float]]></text>
			<feedback>
				<text><![CDATA[Un float s'écrit avec un point, sans guillemets, comme 42.0. Ici, les guillemets en font un texte.]]></text>
			</feedback>
		</answer>
		<answer fraction="0" format="plain_text">
			<text><![CDATA[NoneType]]></text>
			<feedback>
				<text><![CDATA[NoneType est le type de None seulement. "42" est un texte.]]></text>
			</feedback>
		</answer>
	</question>
	<question type="multichoice">
		<name>
			<text><![CDATA[[Types] Convertir un nombre à virgule en entier]]></text>
		</name>
		<questiontext format="html">
			<text><![CDATA[<div style="font-family: Arial, Helvetica, sans-serif; font-size: 14px;"><p style="color: #3b3b3b;"><strong>Objectif :</strong> Savoir que int tronque un flottant (il ne l'arrondit pas).</p><p>Quelle est la valeur de l'expression <code style="font-family: 'Courier New', Courier, monospace; background-color: #f0f0f0; color: #8b0f0f; padding: 1px 4px; border-radius: 3px;">int(7.9)</code> ?</p></div>]]></text>
		</questiontext>
		<externallink/>
		<usecase>1</usecase>
		<defaultgrade>1</defaultgrade>
		<single>true</single>
		<shuffleanswers>false</shuffleanswers>
		<answer fraction="100" format="plain_text">
			<text><![CDATA[7]]></text>
			<feedback>
				<text><![CDATA[Oui : int garde la partie entière et coupe le reste. int(7.9) vaut 7.]]></text>
			</feedback>
		</answer>
		<answer fraction="0" format="plain_text">
			<text><![CDATA[8]]></text>
			<feedback>
				<text><![CDATA[int n'arrondit pas : il coupe la partie après la virgule. Pour arrondir, on utilise round(7.9), qui donne 8.]]></text>
			</feedback>
		</answer>
		<answer fraction="0" format="plain_text">
			<text><![CDATA[7.9]]></text>
			<feedback>
				<text><![CDATA[int change le type : le résultat est un entier, sans virgule.]]></text>
			</feedback>
		</answer>
		<answer fraction="0" format="plain_text">
			<text><![CDATA[Une erreur]]></text>
			<feedback>
				<text><![CDATA[int accepte un flottant : la conversion est permise. Elle donne 7.]]></text>
			</feedback>
		</answer>
	</question>
	<question type="multichoice">
		<name>
			<text><![CDATA[[Types] Convertir un texte en entier]]></text>
		</name>
		<questiontext format="html">
			<text><![CDATA[<div style="font-family: Arial, Helvetica, sans-serif; font-size: 14px;"><p style="color: #3b3b3b;"><strong>Objectif :</strong> Utiliser int pour calculer avec un nombre écrit dans un texte.</p><p>Quelle est la valeur de l'expression <code style="font-family: 'Courier New', Courier, monospace; background-color: #f0f0f0; color: #8b0f0f; padding: 1px 4px; border-radius: 3px;">int("42") + 1</code> ?</p></div>]]></text>
		</questiontext>
		<externallink/>
		<usecase>1</usecase>
		<defaultgrade>1</defaultgrade>
		<single>true</single>
		<shuffleanswers>false</shuffleanswers>
		<answer fraction="0" format="plain_text">
			<text><![CDATA["421"]]></text>
			<feedback>
				<text><![CDATA["421" serait une concaténation de textes. Ici, int("42") donne le nombre 42 : on fait une vraie addition.]]></text>
			</feedback>
		</answer>
		<answer fraction="100" format="plain_text">
			<text><![CDATA[43]]></text>
			<feedback>
				<text><![CDATA[Oui : int("42") transforme le texte en nombre 42, puis 42 + 1 = 43. C'est ce qu'on fait avec le résultat de input().]]></text>
			</feedback>
		</answer>
		<answer fraction="0" format="plain_text">
			<text><![CDATA[42]]></text>
			<feedback>
				<text><![CDATA[Le + 1 n'est pas oublié : après la conversion, Python calcule 42 + 1 = 43.]]></text>
			</feedback>
		</answer>
		<answer fraction="0" format="plain_text">
			<text><![CDATA[Une erreur TypeError]]></text>
			<feedback>
				<text><![CDATA[Il n'y a pas d'erreur : int("42") est un nombre, et on peut lui ajouter 1. Sans int, "42" + 1 donnerait une TypeError.]]></text>
			</feedback>
		</answer>
	</question>
	<question type="multichoice">
		<name>
			<text><![CDATA[[Opérateurs] La division entière //]]></text>
		</name>
		<questiontext format="html">
			<text><![CDATA[<div style="font-family: Arial, Helvetica, sans-serif; font-size: 14px;"><p style="color: #3b3b3b;"><strong>Objectif :</strong> Calculer un quotient entier avec //.</p><p>Quelle est la valeur de l'expression <code style="font-family: 'Courier New', Courier, monospace; background-color: #f0f0f0; color: #8b0f0f; padding: 1px 4px; border-radius: 3px;">7 // 2</code> ?</p></div>]]></text>
		</questiontext>
		<externallink/>
		<usecase>1</usecase>
		<defaultgrade>1</defaultgrade>
		<single>true</single>
		<shuffleanswers>false</shuffleanswers>
		<answer fraction="0" format="plain_text">
			<text><![CDATA[3.5]]></text>
			<feedback>
				<text><![CDATA[3.5 est le résultat de la division 7 / 2, avec une seule barre. Avec deux barres, // garde le quotient entier.]]></text>
			</feedback>
		</answer>
		<answer fraction="0" format="plain_text">
			<text><![CDATA[4]]></text>
			<feedback>
				<text><![CDATA[// n'arrondit pas à l'entier le plus proche : il garde le quotient de la division euclidienne, 3.]]></text>
			</feedback>
		</answer>
		<answer fraction="0" format="plain_text">
			<text><![CDATA[7/2]]></text>
			<feedback>
				<text><![CDATA[Python calcule l'expression : il n'affiche pas une fraction. 7 // 2 vaut 3.]]></text>
			</feedback>
		</answer>
		<answer fraction="100" format="plain_text">
			<text><![CDATA[3]]></text>
			<feedback>
				<text><![CDATA[Oui : // donne le quotient entier. 7 = 2 × 3 + 1, donc 7 // 2 vaut 3.]]></text>
			</feedback>
		</answer>
	</question>
