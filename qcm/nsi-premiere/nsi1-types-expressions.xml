		<externallink/>
		<usecase>1</usecase>
		<defaultgrade>1</defaultgrade>
		<single>true</single>
		<shuffleanswers>false</shuffleanswers>
		<answer fraction="100" format="plain_text">
			<text><![CDATA[14]]></text>
			<feedback>
				<text><![CDATA[Oui : comme en mathématiques, * passe avant + : 3 * 4 = 12, puis 2 + 12 = 14.]]></text>
			</feedback>
		</answer>
